    <!-- Descriptions -->
    <string name="template_desc_cook">সুস্বাদু খাবার প্রস্তুত করার জন্য একজন অভিজ্ঞ রাঁধুনির সন্ধান করছি। বিভিন্ন রান্নার ভালো জ্ঞান থাকতে হবে এবং উচ্চ স্বাস্থ্যবিধি বজায় রাখতে হবে।</string>
    <string name="template_desc_maid">পরিষ্কার করা, ধুলো ঝাড়া এবং গুছিয়ে রাখা সহ দৈনন্দিন ঘরের কাজের জন্য একজন নির্ভরযোগ্য এবং বিশ্বস্ত গৃহকর্মীর সন্ধান করছি।</string>
    <string name="template_desc_driver">যাত্রীদের নিরাপদে যাতায়াত করার জন্য বৈধ লাইসেন্স সহ একজন দায়িত্বশীল ড্রাইভারের সন্ধান করছি। সুরক্ষাকে অগ্রাধিকার দিতে হবে এবং ট্রাফিক নিয়ম কঠোরভাবে মেনে চলতে হবে।</string>
    <string name="template_desc_office_boy">দৈনন্দিন অফিসের কাজে সহায়তা করা, চা/কফি পরিবেশন করা এবং বেসিক ফাইল পরিচালনার জন্য একজন সক্রিয় অফিস বয়ের সন্ধান করছি।</string>
    <string name="template_desc_security_guard">প্রাঙ্গণ সুরক্ষিত রাখা, নজরদারি সরঞ্জাম নিরীক্ষণ করা এবং নিরাপদ পরিবেশ নিশ্চিত করার জন্য একজন সজাগ নিরাপত্তারক্ষীর সন্ধান করছি।</string>
    <string name="template_desc_delivery">গ্রাহকদের কাছে প্যাকেজগুলির সময়মতো এবং নিরাপদ ডেলিভারি নিশ্চিত করার জন্য একজন উদ্যমী ডেলিভারি এক্সিকিউটিভের সন্ধান করছি।</string>
    <string name="template_desc_electrician">বৈদ্যুতিক তার এবং সরঞ্জাম ইনস্টল, রক্ষণাবেক্ষণ এবং মেরামত করার জন্য একজন দক্ষ ইলেকট্রিশিয়ান সন্ধান করছি।</string>
    <string name="template_desc_plumber">জল সরবরাহ লাইন, নিষ্কাশন ব্যবস্থা এবং ফিক্সচার ইনস্টল এবং মেরামত করার জন্য একজন অভিজ্ঞ প্লাম্বার সন্ধান করছি।</string>
    <string name="template_desc_carpenter">কাঠের তৈরি কাঠামো এবং ফিক্সচার নির্মাণ, ইনস্টল এবং মেরামত করার জন্য একজন দক্ষ কাঠমিস্ত্রির সন্ধান করছি।</string>
    <string name="template_desc_painter">ভবন এবং কাঠামোর পৃষ্ঠে পেইন্ট, বার্নিশ এবং অন্যান্য ফিনিস প্রয়োগ করার জন্য একজন যত্নশীল পেইন্টারের সন্ধান করছি।</string>
    <string name="template_desc_welder">বিভিন্ন ওয়েল্ডিং কৌশল ব্যবহার করে ধাতব অংশ যুক্ত করার জন্য একজন প্রত্যয়িত ওয়েল্ডারের সন্ধান করছি।</string>
    <string name="template_desc_mechanic">যানবাহন বা যন্ত্রপাতি পরিদর্শন, রক্ষণাবেক্ষণ এবং মেরামত করার জন্য একজন জ্ঞানী মেকানিকের সন্ধান করছি।</string>
    <string name="template_desc_cleaner">বাণিজ্যিক বা আবাসিক সম্পত্তিতে পরিচ্ছন্নতা বজায় রাখার জন্য একজন পরিশ্রমী ক্লিনারের সন্ধান করছি।</string>
    <string name="template_desc_mason">ইট, পাথর এবং কংক্রিট ব্যবহার করে কাঠামো নির্মাণ এবং মেরামত করার জন্য একজন দক্ষ রাজমিস্ত্রির সন্ধান করছি।</string>
    <string name="template_desc_technician">সরঞ্জাম ইনস্টল, সমস্যা সমাধান এবং মেরামত করার জন্য একজন প্রযুক্তিগতভাবে দক্ষ টেকনিশিয়ানের সন্ধান করছি।</string>
    <string name="template_desc_other">এই ভূমিকার জন্য একজন নিবেদিত পেশাদারের সন্ধান করছি।</string>

